# LLM (Phase 2) — leave the key empty to run rules only
ANTHROPIC_API_KEY=
BATON_LLM_MODEL=claude-opus-5-5

# Zoom (Phase 3) — create the app in Zoom App Marketplace, then fill these in
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Webhook "Secret Token" (Features → Access)
ZOOM_SECRET_TOKEN=

# Server
PORT=8080
# Workshop script for every meeting (omit for meeting mode), e.g. fixtures/workshops/design-sprint-lite.zh.json
BATON_WORKSHOP=
# Nudge language in meeting mode: zh (default) | ja | en (workshop mode uses the script's locale)
BATON_LOCALE=zh
# Where adopted/ignored verdicts are appended (rule metadata only, no nudge text)
BATON_FEEDBACK_FILE=data/feedback.jsonl
# 1 = log each RTMS transcript segment's timestamps/sizes (never text or names) to check Zoom's segmenting
BATON_DEBUG_TRANSCRIPT=
